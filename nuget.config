<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Só o nuget.org, e só os prefixos esperados: um pacote de outra origem não entra (SPECS §11). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="runtime.win-x64.Microsoft.DotNet.ILCompiler" />
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="coverlet.collector" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="NetVips" />
      <package pattern="NetVips.Native.win-x64" />
    </packageSource>
  </packageSourceMapping>
</configuration>
