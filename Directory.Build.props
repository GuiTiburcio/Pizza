<Project>
  <!-- Configurações comuns a todos os projetos da solução. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <!-- Dependências travadas por lockfile; no CI, qualquer divergência quebra o build (SPECS §11). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>

    <Product>Pizza</Product>
    <Company>Guilherme Tiburcio</Company>
    <Copyright>© 2026 Guilherme Tiburcio. Licenciado sob a GPL-3.0.</Copyright>
    <Version>0.1.1</Version>
    <NeutralLanguage>pt-BR</NeutralLanguage>
  </PropertyGroup>
</Project>
