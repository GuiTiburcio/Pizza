<Project Sdk="Microsoft.NET.Sdk">

  <!-- IConverter e as implementações por família (Imagem, PDF, Office, Mídia). Não fala com a UI. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pizza.Core\Pizza.Core.csproj" />
  </ItemGroup>

  <!-- ADR-004: conversão de imagens. NetVips é MIT; a libvips nativa é LGPL, usada como biblioteca dinâmica. -->
  <ItemGroup>
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.7" />
  </ItemGroup>

  <!--
    ADR-033: QPDF (Apache-2.0) para as operações de estrutura de PDF. Vem da release oficial, com versão e
    SHA-256 fixados; só a DLL e o runtime do Visual C++ que ela importa vão para a pasta do Worker.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <QpdfVersion>12.4.2</QpdfVersion>
    <QpdfSha256>db87077e683630c1217e0e8f9a20a9749d952ab676e881c3689187763a5de25d</QpdfSha256>
    <QpdfZip>qpdf-$(QpdfVersion)-msvc64.zip</QpdfZip>
    <QpdfCache>$(MSBuildThisFileDirectory)..\..\artifacts\deps\qpdf-$(QpdfVersion)\</QpdfCache>
    <QpdfBin>$(QpdfCache)qpdf-$(QpdfVersion)-msvc64\bin\</QpdfBin>
  </PropertyGroup>

  <ItemGroup>
    <QpdfRuntime Include="qpdf30.dll;msvcp140.dll;vcruntime140.dll;vcruntime140_1.dll" />
    <None Include="@(QpdfRuntime->'$(QpdfBin)%(Identity)')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="FetchQpdf" BeforeTargets="BeforeBuild;AssignTargetPaths" Condition="!Exists('$(QpdfBin)qpdf30.dll')">
    <DownloadFile SourceUrl="https://github.com/qpdf/qpdf/releases/download/v$(QpdfVersion)/$(QpdfZip)" DestinationFolder="$(QpdfCache)" Retries="2" />
    <VerifyFileHash File="$(QpdfCache)$(QpdfZip)" Hash="$(QpdfSha256)" Algorithm="SHA256" />
    <Unzip SourceFiles="$(QpdfCache)$(QpdfZip)" DestinationFolder="$(QpdfCache)" />
    <Delete Files="$(QpdfCache)$(QpdfZip)" />
  </Target>

  <!--
    ADR-033 (adendo de 15/11/2026): PDFium (BSD-3 e Apache-2.0) desenha as páginas e tira o texto. Vem do
    empacotamento pdfium-binaries (MIT), compilado sem V8 e sem XFA: nenhum JavaScript de PDF roda. Versão e
    SHA-256 fixados; o hash é o mesmo que o GitHub publica para o arquivo da release.
  -->
  <PropertyGroup>
    <PdfiumVersion>8152</PdfiumVersion>
    <PdfiumSha256>cee2b0e9990bc67c0721774932961b9dbf2766046c10eec925acd4cfba6fdfe3</PdfiumSha256>
    <PdfiumArchive>pdfium-win-x64.tgz</PdfiumArchive>
    <PdfiumCache>$(MSBuildThisFileDirectory)..\..\artifacts\deps\pdfium-chromium-$(PdfiumVersion)\</PdfiumCache>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PdfiumCache)bin\pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="FetchPdfium" BeforeTargets="BeforeBuild;AssignTargetPaths" Condition="!Exists('$(PdfiumCache)bin\pdfium.dll')">
    <DownloadFile SourceUrl="https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/$(PdfiumVersion)/$(PdfiumArchive)" DestinationFolder="$(PdfiumCache)" Retries="2" />
    <VerifyFileHash File="$(PdfiumCache)$(PdfiumArchive)" Hash="$(PdfiumSha256)" Algorithm="SHA256" />
    <Exec Command="tar -xzf &quot;$(PdfiumCache)$(PdfiumArchive)&quot; -C &quot;$(PdfiumCache).&quot; bin/pdfium.dll LICENSE" />
    <Delete Files="$(PdfiumCache)$(PdfiumArchive)" />
  </Target>

  <!--
    ADR-040: libjxl (BSD-3-Clause) para o formato JPEG XL, só no Worker. Release oficial, build x64 com DLLs
    dinâmicas e SHA-256 fixado; só as DLLs que a jxl.dll importa vão para a pasta do Worker. O runtime do
    Visual C++ já vem junto com a QPDF.
  -->
  <PropertyGroup>
    <JxlVersion>0.11.2</JxlVersion>
    <JxlSha256>54886b2d7a9ef625bc2b2e7b2b81b186f5b310376fd67d2fbbb3fcf3be01ad7a</JxlSha256>
    <JxlZip>jxl-x64-windows.zip</JxlZip>
    <JxlCache>$(MSBuildThisFileDirectory)..\..\artifacts\deps\libjxl-$(JxlVersion)\</JxlCache>
    <JxlBin>$(JxlCache)bin\</JxlBin>
  </PropertyGroup>

  <ItemGroup>
    <JxlRuntime Include="jxl.dll;jxl_cms.dll;jxl_threads.dll;brotlicommon.dll;brotlidec.dll;brotlienc.dll" />
    <None Include="@(JxlRuntime->'$(JxlBin)%(Identity)')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="FetchJxl" BeforeTargets="BeforeBuild;AssignTargetPaths" Condition="!Exists('$(JxlBin)jxl.dll')">
    <DownloadFile SourceUrl="https://github.com/libjxl/libjxl/releases/download/v$(JxlVersion)/$(JxlZip)" DestinationFolder="$(JxlCache)" Retries="2" />
    <VerifyFileHash File="$(JxlCache)$(JxlZip)" Hash="$(JxlSha256)" Algorithm="SHA256" />
    <Unzip SourceFiles="$(JxlCache)$(JxlZip)" DestinationFolder="$(JxlCache)" />
    <Delete Files="$(JxlCache)$(JxlZip)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Pizza.Converters.Tests" />
  </ItemGroup>

  <!-- ADR-041: encoder Apple compilado localmente/CI de fonte imutável; runtime sem downloads. -->
  <PropertyGroup><AlacOutput>$(MSBuildThisFileDirectory)..\..\artifacts\native\alac</AlacOutput></PropertyGroup>
  <ItemGroup>
    <None Include="$(AlacOutput)\Pizza.Alac.dll" Link="Pizza.Alac.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(AlacOutput)\ALAC-LICENSE.txt" Link="ALAC-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(AlacOutput)\ALAC-NOTICE.txt" Link="ALAC-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(AlacOutput)\ALAC-BUILD.json" Link="ALAC-BUILD.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="BuildAppleAlac" BeforeTargets="BeforeBuild;AssignTargetPaths"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)..\..\tools\build-alac.ps1;$(MSBuildThisFileDirectory)..\..\native\Pizza.Alac\Pizza.Alac.cpp;$(MSBuildThisFileDirectory)..\..\native\Pizza.Alac\Pizza.Alac.vcxproj;$(MSBuildThisFileDirectory)..\..\native\Pizza.Alac\NOTICE.txt"
          Outputs="$(AlacOutput)\Pizza.Alac.dll;$(AlacOutput)\ALAC-LICENSE.txt;$(AlacOutput)\ALAC-NOTICE.txt;$(AlacOutput)\ALAC-BUILD.json">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\tools\build-alac.ps1&quot; -Output &quot;$(AlacOutput)&quot;" />
  </Target>

</Project>
